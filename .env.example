# NVIDIA NIM. Copia este archivo como .env y pega una API key nueva aquí.
# Revoca primero cualquier clave que haya estado escrita directamente en un .py.
base_url=https://integrate.api.nvidia.com/v1
api_key=

# La entrevista normal usa este modelo ligero primero.
modelo_flash=z-ai/glm-5.3-flash

# Si el endpoint no reconoce el modelo Flash principal, intenta este Flash alternativo.
modelo_flash_alternativo=nvidia/nemotron-3.5-lightning-30b-a3b

# Solo pedidos detectados como complejos utilizan este modelo más potente.
modelo_complejo=nvidia/nemotron-3-ultra-550b-a55b
